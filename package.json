{
  "name": "panelyzer",
  "version": "0.9.0",
  "description": "Offline, single-file tool for designing spectral flow cytometry panels: similarity, complexity, predicted spread, fluor and marker optimization, with Honeychrome integration.",
  "license": "LGPL-3.0-or-later",
  "author": "Cole Batty",
  "homepage": "https://colejbatty.github.io/panelyzer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colejbatty/panelyzer.git"
  },
  "bugs": {
    "url": "https://github.com/colejbatty/panelyzer/issues"
  },
  "keywords": [
    "flow cytometry",
    "spectral cytometry",
    "panel design",
    "fluorochrome",
    "unmixing",
    "honeychrome"
  ],
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.cjs",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "validate": "node tools/validate_against_library.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:plugin": "python -m pytest -q plugin/tests"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
