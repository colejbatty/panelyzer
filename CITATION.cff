cff-version: 1.2.0
message: "If you use Panelyzer, please cite it as below, and cite FPbase for the spectra."
title: "Panelyzer: offline spectral flow cytometry panel design"
abstract: "Offline, single-file tool for designing spectral flow cytometry panels: signature similarity, complexity index, predicted spillover spreading, fluor-set and marker-assignment optimization, with Honeychrome integration. Developed with substantial assistance from Claude (Anthropic), a generative AI model, under the direction of Cole Batty; see the README."
type: software
authors:
  - family-names: Batty
    given-names: Cole
version: 0.9.0
date-released: 2026-10-20
license: LGPL-3.0-or-later
repository-code: "https://github.com/colejbatty/panelyzer"
url: "https://colejbatty.github.io/panelyzer/"
keywords:
  - flow cytometry
  - spectral cytometry
  - panel design
  - unmixing
references:
  - type: article
    title: "FPbase: a community-editable fluorescent protein database"
    authors:
      - family-names: Lambert
        given-names: Talley J.
    journal: "Nature Methods"
    volume: 16
    start: 277
    end: 278
    year: 2019
    doi: "10.1038/s41592-019-0352-8"
